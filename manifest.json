{
  "manifest_version": 3,
  "name": "Detained?",
  "version": "1.0.0",
  "description": "Am I getting detained? Find out instantly — live attendance %, leave calculator & scenario simulator on PSIT ERP.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://erp.psit.ac.in/Student/MyAttendanceDetail*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
