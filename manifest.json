{
  "manifest_version": 3,
  "name": "Detained?",
  "version": "2.0.2",
  "description": "Am I getting detained? Smart attendance tracker for PSIT ERP — live %, leave calculator, simulator, trend graph & smart alerts.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "host_permissions": [
    "https://whydetained.pages.dev/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline';"
  },

  "content_scripts": [
    {
      "matches": [
        "https://erp.psit.ac.in/Student/MyAttendanceDetail*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
